row, col = map(int, input().split())

matrix = []

for i in range(row):
    matrix.append(list(input()))


# # 폭탄 리스트 만들기
# booms = []

for y in range(row):
    boom_x = []

    for x in range(col):

        if matrix[y][x] == '*':
            boom_x.append(1)
        else:
            boom_x.append(0)

    booms.append(boom_x)


# 지뢰찾기 맵 출력
for y in range(row):
    result = ""

    for x in range(col):

        # 원래 폭탄이면 *
        if matrix[y][x] == '*':
            result += '*'

        else:
            count = 0

            # 주변 8칸 확인
            for dy in range(-1, 2):
                for dx in range(-1, 2):

                    ny = y + dy
                    nx = x + dx

                    # 맵 안에 있는 경우만
                    if 0 <= ny < row and 0 <= nx < col:
                        count += booms[ny][nx]

            result += str(count)

    print(result)
